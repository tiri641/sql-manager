{
  "name": "@sql-patch-manager/cdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "build": "tsc -p tsconfig.json",
    "synth": "npm run build && cdk synth --context environment=dev",
    "nag": "npm run build && cdk synth --context environment=dev --context runNag=true",
    "security:scan": "node scripts/security-scan.mjs"
  },
  "dependencies": {
    "aws-cdk-lib": "2.271.0",
    "cdk-nag": "2.36.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "aws-cdk": "2.1143.0",
    "typescript": "^5.9.3"
  }
}
