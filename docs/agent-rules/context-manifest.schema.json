{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "workingTreeDigest", "allowedFiles", "verification", "sensitiveData"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "workingTreeDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dirty": { "type": "boolean" },
    "untracked": { "type": "boolean" },
    "allowedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "lineRanges"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+" },
          "lineRanges": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end"],
              "properties": {
                "start": { "type": "integer", "minimum": 1 },
                "end": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "digest"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed", "not-run"] },
          "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "sensitiveData": { "const": false }
  }
}
